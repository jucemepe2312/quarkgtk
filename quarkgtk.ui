<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkApplicationWindow" id="win">
    <property name="title">Quark</property>
    <property name="default-width">1000</property>
    <property name="default-height">650</property>
    <style>
      <class name="quark-window"/>
    </style>

    <!-- Barra de título -->
    <property name="titlebar">
      <object class="GtkHeaderBar" id="header">
        <child type="start">
          <object class="GtkToggleButton" id="btn_sidebar">
            <property name="icon-name">sidebar-show-symbolic</property>
            <property name="action-name">win.sidebar</property>
            <property name="tooltip-text">Barra lateral (Ctrl+B)</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btn_nuevo">
            <property name="icon-name">document-new-symbolic</property>
            <property name="action-name">win.nuevo</property>
            <property name="tooltip-text">Nuevo archivo (Ctrl+N)</property>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="btno">
            <property name="icon-name">document-open-symbolic</property>
            <property name="action-name">win.abrir</property>
            <property name="tooltip-text">Abrir archivos (Ctrl+O)</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="btns">
            <property name="icon-name">document-save-symbolic</property>
            <property name="action-name">win.guardar</property>
            <property name="tooltip-text">Guardar (Ctrl+S)</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="btn_guardar_como">
            <property name="icon-name">document-save-as-symbolic</property>
            <property name="action-name">win.guardar-como</property>
            <property name="tooltip-text">Guardar como… (Ctrl+Mayús+S)</property>
          </object>
        </child>
      </object>
    </property>

    <child>
      <object class="GtkPaned" id="paned">
        <property name="position">260</property>
        <property name="shrink-start-child">FALSE</property>
        <property name="resize-start-child">FALSE</property>
        <property name="shrink-end-child">FALSE</property>

        <!-- Panel lateral: explorador de archivos -->
        <property name="start-child">
          <object class="GtkBox" id="panel_izquierdo">
            <property name="orientation">vertical</property>
            <property name="width-request">180</property>
            <style>
              <class name="quark-sidebar"/>
            </style>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <style>
                  <class name="quark-sidebar-header"/>
                </style>
                <child>
                  <object class="GtkLabel" id="lbl_carpeta">
                    <property name="label">SIN CARPETA</property>
                    <property name="hexpand">TRUE</property>
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_carpeta">
                    <property name="icon-name">folder-open-symbolic</property>
                    <property name="action-name">win.abrir-carpeta</property>
                    <property name="tooltip-text">Abrir carpeta (Ctrl+Mayús+O)</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vexpand">TRUE</property>
                <property name="hscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkListView" id="arbol">
                    <property name="single-click-activate">FALSE</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>

        <!-- Zona de edición -->
        <property name="end-child">
          <object class="GtkBox" id="box_editor">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkNotebook" id="nb">
                <property name="hexpand">TRUE</property>
                <property name="vexpand">TRUE</property>
                <property name="scrollable">TRUE</property>
                <property name="show-border">FALSE</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="barra_estado">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <style>
                  <class name="quark-statusbar"/>
                </style>
                <child>
                  <object class="GtkLabel" id="lbl_pos">
                    <property name="hexpand">TRUE</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_lang">
                    <property name="xalign">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>